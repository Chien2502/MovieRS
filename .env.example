# TMDb API Configuration
# Get your free API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_api_key_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Set API_RELOAD=0 để tắt auto-reload khi chạy demo (mặc định 1)
# API_RELOAD=1

# CORS origins (phân tách bằng dấu phẩy, '*' = cho phép tất cả)
# CORS_ORIGINS=*

# Model Configuration
MODEL_PATH=models/model_latest.pkl
MODEL_VERSION=v1

# API đọc .env; CLI retrain/train đọc biến môi trường OS hoặc các cờ CLI.
SVD_N_FACTORS=50
SVD_LR_ALL=0.005
SVD_REG_ALL=0.05
SVD_N_EPOCHS=20

# Model Gate: sai số RMSE cho phép khi so với model hiện tại (0.0 = không tệ hơn)
GATE_TOLERANCE=0.0

# Dataset Configuration
DATASET_SIZE=25m

# V2 luôn chạy worker riêng; các biến AUTO_RETRAIN chỉ còn cho tương thích V1.
AUTO_RETRAIN=0
AUTO_RETRAIN_MIN_ROWS=5
AUTO_RETRAIN_MAX_IDLE=3600
AUTO_RETRAIN_MIN_INTERVAL=300

# ===== Supabase / PostgreSQL =====
SUPABASE_PROJECT_REF=mrtjfvtbzupbwdtljihg
SUPABASE_URL=https://mrtjfvtbzupbwdtljihg.supabase.co
# Tùy chọn cho Supabase SDK/Data API sau này; kết nối SQL không dùng hai key này.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Dán URI PostgreSQL từ Supabase Dashboard > Connect > Session pooler.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# PASSWORD là mật khẩu database (URL-encode ký tự đặc biệt), không phải API key.
# Để trống đến khi sẵn sàng; không tự kết nối hoặc đổi kho lưu trữ local.
DATABASE_URL=
DATABASE_SSLMODE=require
DATABASE_CONNECT_TIMEOUT=5
DATABASE_POOL_SIZE=4
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000

# Chỉ chọn postgres sau khi chạy migration và đối soát dữ liệu ứng dụng.
MOVIERS_STORAGE=files
# Bật sau khi worker tạo artifacts/serving/current.json.
MOVIERS_SERVING_POINTER=
# Token riêng cho endpoint reload quản trị; không đưa vào Flutter.
ADMIN_API_TOKEN=
